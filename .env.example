# Copy to .env and fill in. Every value is optional except the Cloudflare Access pair
# in production.

# Where the SQLite database, caches and scan images live (a Docker volume in production).
DATA_DIR=/data
TZ=Australia/Sydney

# Cloudflare Access. Team domain is <team>.cloudflareaccess.com; AUD is the application's
# audience tag from Zero Trust > Access > Applications > Configure > Additional settings.
# With both set, every request must carry a valid Cf-Access-Jwt-Assertion.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# App-issued bearer token for MCP clients that cannot send Access service-token headers
# (claude.ai and Claude Desktop connectors). Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Scryfall asks for a descriptive User-Agent. Keep the app name and a contact URL.
SCRYFALL_USER_AGENT=MtgCollection/0.1 (+https://github.com/Nathaniel-Roberts/mtg-collection)

# Daily job: catalogue sync, price snapshot, FX, value rollup. Local time in TZ.
SYNC_HOUR=06:00
SYNC_ON_START=true

# AUD conversion: frankfurter (ECB reference rates, no key) or manual.
FX_PROVIDER=frankfurter
FX_USD_AUD=
FX_EUR_AUD=

# Scanner thresholds (Phase 3).
SCAN_GAP=0.10
SCAN_MIN_SCORE=0.55
SCAN_KEEP_IMAGES=200
CV_CATALOG=mtg
CV_OFFLINE=false

# Local development only: every request acts as DEV_USER_EMAIL with no Access check.
DEV_MODE=false
DEV_USER_EMAIL=dev@localhost

# cloudflared (docker-compose.yml)
TUNNEL_TOKEN=
